# ==========================================
# BinmarDrive Mobile Environment Config Template
# ==========================================
# Copy this file to .env and adjust values if needed.
# Expo auto-exposes all EXPO_PUBLIC_* variables to the app.

EXPO_PUBLIC_BASE_URL=https://binmardrive.binmargroup.com
EXPO_PUBLIC_API_URL=https://binmardrive.binmargroup.com/api
EXPO_PUBLIC_ADMIN_API_URL=https://binmardrive.binmargroup.com/api/admin

# App Metadata
EXPO_PUBLIC_APP_NAME=BinmarDrive
EXPO_PUBLIC_APP_VERSION=1.0.0
