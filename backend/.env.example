# ========================================================
# BinmarDrive Backend API - Environment Variables Template
# ========================================================
# Copy this file to .env:
#   cp .env.example .env

# Server Configuration
PORT=5005
NODE_ENV=production

# Live Public URL
LIVE_BASE_URL=https://binmardrive.binmargroup.com
CORS_ORIGIN=*

# Microsoft SQL Server (MSSQL) Database
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_USER=binmar_user
DB_PASSWORD=YourStrongPasswordHere!
DB_NAME=binmar_rent_car

# Super Admin Credentials
ADMIN_EMAIL=admin@binmardrive.com
ADMIN_PASSWORD=admin123
